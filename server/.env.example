# Server
PORT=5000
NODE_ENV=development
# Allowed browser origin(s) for CORS, comma-separated. In development the three
# `npm run dev:demo` ports (5173, 5174, 5175) are always allowed as well.
CLIENT_URL=http://localhost:5173

# Database — the database name MUST be "simsar"
MONGO_URI=mongodb://localhost:27017/simsar

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Login/register attempts per IP per 15 minutes. Leave empty for the default:
# 50 in production, 1000 in development (so a three-tab demo is never locked out).
AUTH_RATE_LIMIT=

# Fair broker: fixed platform commission taken from each job budget (percent)
PLATFORM_FEE_PERCENT=5
